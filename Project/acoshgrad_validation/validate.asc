#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>
#include <fstream>
#include "acl/acl.h"
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#ifndef VALIDATION_KERNEL
#define VALIDATION_KERNEL "../acoshgrad_problem_1916_template/kernel.asc"
#endif
#include VALIDATION_KERNEL
#define CHECK(x) do { auto e=(x); if(e) {fprintf(stderr,"%s: %d\n",#x,int(e)); return 1;} } while(0)
int main(int argc, char** argv) {
    if (argc < 4) return 2;
    int dtype=atoi(argv[1]);
    int64_t n=atoll(argv[2]);
    int rank=atoi(argv[3]);
    std::vector<int64_t> shape(rank,1);
    if(rank) shape[rank-1]=n;
    if(n > 1048576 && rank >= 2) {shape[rank-2]=n/1048576; shape[rank-1]=1048576;}
    TensorInfo ti{shape.data(),rank,dtype}; TensorGroupInfo info{&ti,1};
    size_t bytes=n*(dtype==0?4:2), guard=64;
    std::vector<uint8_t> hy(bytes),hd(bytes),hz(bytes+guard,0xA5);
    std::ifstream("y.bin",std::ios::binary).read((char*)hy.data(),bytes);
    std::ifstream("dy.bin",std::ios::binary).read((char*)hd.data(),bytes);
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(0));
    int64_t cores=0; CHECK(aclrtGetDeviceInfo(0,ACL_DEV_ATTR_VECTOR_CORE_NUM,&cores));
    aclrtStream stream; CHECK(aclrtCreateStream(&stream));
    void *y,*d,*z;
    CHECK(aclrtMalloc(&y,bytes,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&d,bytes,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&z,bytes+guard,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(y,bytes,hy.data(),bytes,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(d,bytes,hd.data(),bytes,ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(z,bytes+guard,hz.data(),bytes+guard,ACL_MEMCPY_HOST_TO_DEVICE));
    for(int i=0;i<3;++i) run_kernel((uint8_t*)y,info,(uint8_t*)d,info,(uint8_t*)z,info,cores,stream);
    CHECK(aclrtSynchronizeStream(stream));
    aclrtEvent start,end; CHECK(aclrtCreateEvent(&start)); CHECK(aclrtCreateEvent(&end));
    CHECK(aclrtRecordEvent(start,stream));
    for(int i=0;i<20;++i) run_kernel((uint8_t*)y,info,(uint8_t*)d,info,(uint8_t*)z,info,cores,stream);
    CHECK(aclrtRecordEvent(end,stream)); CHECK(aclrtSynchronizeStream(stream));
    float ms=0; CHECK(aclrtEventElapsedTime(&ms,start,end));
    CHECK(aclrtMemcpy(hz.data(),bytes+guard,z,bytes+guard,ACL_MEMCPY_DEVICE_TO_HOST));
    for(size_t i=bytes;i<bytes+guard;++i) if(hz[i]!=0xA5) {fprintf(stderr,"output guard overwritten\n");return 3;}
    std::ofstream("z.bin",std::ios::binary).write((char*)hz.data(),bytes);
    printf("cores=%lld mean_us=%.3f guard=OK\n",(long long)cores,ms*1000/20);
    CHECK(aclrtDestroyEvent(start)); CHECK(aclrtDestroyEvent(end));
    CHECK(aclrtFree(y)); CHECK(aclrtFree(d)); CHECK(aclrtFree(z));
    CHECK(aclrtDestroyStream(stream)); CHECK(aclrtResetDevice(0)); CHECK(aclFinalize());
}
