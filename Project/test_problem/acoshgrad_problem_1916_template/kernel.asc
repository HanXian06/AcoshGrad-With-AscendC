#include "kernel_operator.h"
/*
 * AcoshGrad Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

namespace acosh_grad_detail {
using namespace AscendC;

template<class T> __aicore__ inline void Promote(LocalTensor<float> dst, LocalTensor<T> src, uint32_t n) {
    Cast(dst, src, RoundMode::CAST_NONE, n);
}
template<class T> __aicore__ inline void Demote(LocalTensor<T> dst, LocalTensor<float> src, uint32_t n) {
    Cast(dst, src, RoundMode::CAST_RINT, n);
}

template<class T> __aicore__ inline void Compute(LocalTensor<T> z, LocalTensor<T> y,
        LocalTensor<T> d, LocalTensor<float> yf, LocalTensor<float> df, uint32_t n) {
    Promote(yf, y, n);
    Promote(df, d, n);
    Mul(yf, yf, yf, n);
    Adds(yf, yf, -1.0f, n);
    Sqrt(yf, yf, n);
    Div(df, df, yf, n);
    Demote(z, df, n);
}
__aicore__ inline void Compute(LocalTensor<float> z, LocalTensor<float> y,
        LocalTensor<float> d, LocalTensor<float> yf, LocalTensor<float> df, uint32_t n) {
    // FP32 inputs already have the required precision: avoid identity copies.
    Mul(yf, y, y, n);
    Adds(yf, yf, -1.0f, n);
    Sqrt(yf, yf, n);
    Div(z, d, yf, n);
}

template<class T> class Kernel {
    // Measured on dav-2201: larger tiles help the conversion path.
    static constexpr uint32_t TILE = sizeof(T) == 4 ? 2048 : 4096;
    TPipe pipe;
    TQue<QuePosition::VECIN, 2> yq, dq;
    TQue<QuePosition::VECOUT, 2> zq;
    TBuf<QuePosition::VECCALC> yfbuf, dfbuf;
    GlobalTensor<T> yg, dg, zg;
    uint32_t length;
public:
    __aicore__ inline void Init(GM_ADDR y, GM_ADDR dy, GM_ADDR z, uint32_t total) {
        // Partition in 32-byte units; only the last core has a partial block.
        constexpr uint32_t align = 32 / sizeof(T);
        uint32_t units = (total + align - 1) / align;
        uint32_t first = (uint64_t(units) * GetBlockIdx() / GetBlockNum()) * align;
        uint32_t last = (uint64_t(units) * (GetBlockIdx() + 1) / GetBlockNum()) * align;
        last = last < total ? last : total;
        length = last - first;
        yg.SetGlobalBuffer((__gm__ T*)y + first, length);
        dg.SetGlobalBuffer((__gm__ T*)dy + first, length);
        zg.SetGlobalBuffer((__gm__ T*)z + first, length);
        pipe.InitBuffer(yq, 2, TILE * sizeof(T));
        pipe.InitBuffer(dq, 2, TILE * sizeof(T));
        pipe.InitBuffer(zq, 2, TILE * sizeof(T));
        pipe.InitBuffer(yfbuf, TILE * sizeof(float));
        pipe.InitBuffer(dfbuf, TILE * sizeof(float));
    }
    __aicore__ inline uint32_t Count(uint32_t off) {
        return length - off < TILE ? length - off : TILE;
    }
    __aicore__ inline void CopyIn(uint32_t off) {
        uint32_t n = Count(off);
        auto y = yq.AllocTensor<T>();
        auto d = dq.AllocTensor<T>();
        DataCopyExtParams cp{1, uint32_t(n * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        DataCopyPad(y, yg[off], cp, pad);
        DataCopyPad(d, dg[off], cp, pad);
        yq.EnQue(y);
        dq.EnQue(d);
    }
    __aicore__ inline void Process() {
        if (!length) return;
        CopyIn(0);
        for (uint32_t off = 0; off < length; off += TILE) {
            if (off + TILE < length) CopyIn(off + TILE);
            uint32_t n = Count(off);
            auto y = yq.DeQue<T>();
            auto d = dq.DeQue<T>();
            auto z = zq.AllocTensor<T>();
            auto yf = yfbuf.Get<float>();
            auto df = dfbuf.Get<float>();
            Compute(z, y, d, yf, df, n);
            yq.FreeTensor(y);
            dq.FreeTensor(d);
            zq.EnQue(z);
            z = zq.DeQue<T>();
            DataCopyExtParams cp{1, uint32_t(n * sizeof(T)), 0, 0, 0};
            DataCopyPad(zg[off], z, cp);
            zq.FreeTensor(z);
        }
    }
};
}

template<class T>
__global__ __vector__ void acosh_grad_custom(GM_ADDR y, GM_ADDR dy, GM_ADDR z, uint32_t total) {
    acosh_grad_detail::Kernel<T> kernel;
    kernel.Init(y, dy, z, total);
    kernel.Process();
}

extern "C" void run_kernel(GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR dy, const TensorGroupInfo& info_dy, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    uint64_t total = 1;
    const auto& tensor = info_y.tensors[0];
    for (int64_t i = 0; i < tensor.numDims; ++i) total *= tensor.shape[i];
    if (!total || availableCoreNum <= 0) return;
    // Avoid excessive launch parallelism for small tensors.
    uint32_t blocks = (total + 2047) / 2048;
    if (blocks > uint64_t(availableCoreNum)) blocks = availableCoreNum;
    if (tensor.dtype == 0) acosh_grad_custom<float><<<blocks, nullptr, stream>>>(y, dy, z, total);
    else if (tensor.dtype == 1) acosh_grad_custom<half><<<blocks, nullptr, stream>>>(y, dy, z, total);
    else if (tensor.dtype == 2) acosh_grad_custom<bfloat16_t><<<blocks, nullptr, stream>>>(y, dy, z, total);
}
